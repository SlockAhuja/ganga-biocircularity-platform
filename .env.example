# GANGA BIOCIRCULARITY INTELLIGENCE PLATFORM
# Environment Configuration Template

# Operational Mode
DEMO_MODE=true
APP_ENV=development
LOG_LEVEL=info

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=ganga-biocircularity-research-key-2026-supersecret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + PostGIS)
# In Demo Mode without Postgres, SQLite in-memory / local fallback is automatically supported
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ganga_biocircularity
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Satellite & Remote Sensing Integration (Sentinel-2 / Copernicus / GEE)
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here
EARTH_ENGINE_PROJECT=ganga-biocircularity-research
SATELLITE_API_KEY=your_sentinel_hub_api_key_here

# Object Storage for Field Photos & Processed GeoTIFFs
OBJECT_STORAGE_URL=https://storage.googleapis.com/ganga-bio-assets
AWS_ACCESS_KEY_ID=your_s3_key_id
AWS_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET_NAME=ganga-biocircularity-data

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_PROVIDER=osm
VITE_MAPBOX_TOKEN=
